# Local development: chạy Backend trực tiếp trên máy, dùng SQLite riêng.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./local-test.db

# Nếu muốn dùng PostgreSQL trong Docker Compose từ máy host, thay bằng:
# DATABASE_URL=postgresql+psycopg://chodocu:doi_mat_khau_nay@localhost:5433/chodocu

# Sinh khóa bằng: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_LISTING=5
MAX_LISTINGS_PER_DAY=5

# Live Server :5500, frontend local và Docker/Nginx :8080
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]

LOG_LEVEL=INFO
LOG_JSON=false
