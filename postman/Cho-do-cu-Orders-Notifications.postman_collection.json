{
  "info": {
    "_postman_id": "b6c5d09a-36af-4d0e-9a2c-0f0f12a6c4c1",
    "name": "Cho-do-cu - Orders & Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bộ request bổ sung cho Orders API và Notifications API. Chạy theo thứ tự; dùng tài khoản buyer/seller thử nghiệm riêng. Không chạy thao tác hủy trên đơn thật."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "api",
      "value": "{{baseUrl}}/api/v1",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sellerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "listingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Đặt mua trực tiếp (buyer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api}}/listings/{{listingId}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"delivery_name\": \"Postman Buyer\",\n  \"delivery_phone\": \"0912345678\",\n  \"delivery_address\": \"Diem hen thu nghiem\",\n  \"payment_method\": \"Gặp trực tiếp\",\n  \"note\": \"Postman integration test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created order',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201){pm.environment.set('orderId',pm.response.json().id);pm.test('Order starts pending',()=>pm.expect(pm.response.json().status).to.eql('pending'));}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Danh sách đơn mua (buyer)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{api}}/orders?side=buying&page_size=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Orders list OK',()=>pm.response.to.have.status(200));",
              "pm.test('Paged response',()=>pm.expect(pm.response.json()).to.have.property('items'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Người bán xác nhận đơn",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}"
          }
        ],
        "url": "{{api}}/orders/{{orderId}}/confirm"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Seller confirmed',()=>pm.response.to.have.status(200));",
              "pm.test('Status confirmed',()=>pm.expect(pm.response.json().status).to.eql('confirmed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Người bán cập nhật đang giao",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}"
          }
        ],
        "url": "{{api}}/orders/{{orderId}}/ship"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Shipped',()=>pm.response.to.have.status(200));",
              "pm.test('Status shipped',()=>pm.expect(pm.response.json().status).to.eql('shipped'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Người mua xác nhận hoàn tất",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{api}}/orders/{{orderId}}/complete"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Completed',()=>pm.response.to.have.status(200));",
              "pm.test('Status completed',()=>pm.expect(pm.response.json().status).to.eql('completed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Danh sách đơn bán (seller)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}"
          }
        ],
        "url": "{{api}}/orders?side=selling&page_size=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Seller orders list OK',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Hộp thông báo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{api}}/notifications?page_size=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Notifications list OK',()=>pm.response.to.have.status(200));",
              "const body=pm.response.json(); if(body.items?.length) pm.environment.set('notificationId',body.items[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Số thông báo chưa đọc",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{api}}/notifications/unread-count"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unread count OK',()=>pm.response.to.have.status(200));",
              "pm.test('Count is numeric',()=>pm.expect(pm.response.json().unread_count).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Đánh dấu một thông báo đã đọc",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{api}}/notifications/{{notificationId}}/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Mark read OK',()=>pm.response.to.have.status(200));",
              "pm.test('read_at set',()=>pm.expect(pm.response.json().read_at).not.to.be.null);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Đánh dấu tất cả đã đọc",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{api}}/notifications/read-all"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Read all OK',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}