# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env lên Git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://chodocu:doi_mat_khau_nay@db:5432/chodocu

# Sinh khóa bằng:  openssl rand -hex 32
JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_LISTING=5
MAX_LISTINGS_PER_DAY=5

# Danh sách JSON
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

LOG_LEVEL=INFO
LOG_JSON=true
